# Where the buttons "Haus einrichten" and "Anmelden" lead: the hosted Waschplaner app.
VITE_APP_URL=https://app.waschplaner.com
# The public source code repository (links in the docs and the footer).
VITE_REPO_URL=https://github.com/waschplaner/waschplaner
# Contact address for support and billing questions.
VITE_CONTACT_EMAIL=hallo@waschplaner.com

# Who runs the site, for the Impressum and the privacy policy. Not committed: set them
# here (.env is ignored by git) and as repository variables for the release workflow.
# The legal name; for a sole proprietorship it must contain your surname (Art. 945 OR),
# e.g. "Waschplaner, Inhaber Max Muster".
VITE_OPERATOR_NAME=
# Postal address without the country, lines separated by "|", e.g. "c/o Muster AG|Musterweg 1|8000 Zürich".
VITE_OPERATOR_ADDRESS=
# UID (CHE-123.456.789) if registered in the commercial register; empty: "not registered".
VITE_OPERATOR_UID=

# Port on the host where the website is served (docker compose).
WEB_PORT=8081
